local function executeScript(code)
	Outputithink.Text = "Executing..."
	local success, err = pcall(function()
		loadstring(code)()
	end)
	if success then
		Outputithink.Text = "Success!"
	else
		Outputithink.Text = "Error: " .. err
	end
end

